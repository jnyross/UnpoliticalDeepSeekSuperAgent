//# sourceURL=https://obr.uk/wp-includes/js/wp-emoji-loader.min.js</script> <script>(function () {
        'use strict';

        let observedCookieBar = null;
        let cookieBarResizeObserver = null;
        let cookieBarMutationObserver = null;

        /**
         * Add keyboard support to the mobile mega-menu toggle.
         */
        function fixMegaMenuAccessibility() {
            const toggleBlock = document.getElementById(
                'mega-toggle-block-1'
            );

            const toggleLabel = document.querySelector(
                '.mega-toggle-label'
            );

            /*
             * Do not return from the main script when the menu is absent,
             * because the accordion and cookie fixes may still be needed.
             */
            if (!toggleBlock || !toggleLabel) {
                return;
            }

            // Prevent the event from being added more than once.
            if (
                toggleLabel.dataset.obrAccessibilityInitialised ===
                'true'
            ) {
                return;
            }

            toggleLabel.dataset.obrAccessibilityInitialised = 'true';

            // Only the visible MENU label receives focus.
            toggleLabel.setAttribute('tabindex', '0');
            toggleLabel.setAttribute('role', 'button');
            toggleLabel.setAttribute(
                'aria-label',
                'Open navigation menu'
            );

            toggleLabel.addEventListener(
                'keydown',
                function (event) {
                    if (
                        event.key === 'Enter' ||
                        event.key === ' '
                    ) {
                        event.preventDefault();

                        toggleBlock.dispatchEvent(
                            new MouseEvent('click', {
                                bubbles: true,
                                cancelable: true,
                                view: window
                            })
                        );
                    }
                }
            );
        }

        /**
         * Remove the tab semantics added by Foundation 6.5.3.
         *
         * The attributes retained include:
         * - aria-controls
         * - aria-expanded
         * - aria-labelledby
         * - aria-hidden
         */
        function cleanFoundationAccordion(accordion) {
            if (accordion.hasAttribute('role')) {
                accordion.removeAttribute('role');
            }

            Array.from(accordion.children).forEach(
                function (item) {
                    if (
                        !item.hasAttribute('data-accordion-item')
                    ) {
                        return;
                    }

                    Array.from(item.children).forEach(
                        function (element) {
                            if (
                                element.classList.contains(
                                    'accordion-title'
                                )
                            ) {
                                if (
                                    element.hasAttribute('role')
                                ) {
                                    element.removeAttribute('role');
                                }

                                if (
                                    element.hasAttribute(
                                        'aria-selected'
                                    )
                                ) {
                                    element.removeAttribute(
                                        'aria-selected'
                                    );
                                }
                            }

                            if (
                                element.hasAttribute(
                                    'data-tab-content'
                                ) &&
                                element.hasAttribute('role')
                            ) {
                                element.removeAttribute('role');
                            }
                        }
                    );
                }
            );
        }

        /**
         * Apply the accessibility fixes to Foundation accordions.
         */
        function fixFoundationAccordions() {
            document.querySelectorAll('[data-accordion]').forEach(
                function (accordion) {
                    /*
                     * Avoid creating multiple observers, but still clean
                     * the accordion if the function runs again.
                     */
                    if (
                        accordion.dataset
                            .obrAccessibilityInitialised ===
                        'true'
                    ) {
                        cleanFoundationAccordion(accordion);
                        return;
                    }

                    accordion.dataset
                        .obrAccessibilityInitialised = 'true';

                    // Remove attributes added during initialisation.
                    cleanFoundationAccordion(accordion);

                    /*
                     * Foundation may add aria-selected again whenever an
                     * accordion section opens or closes.
                     */
                    const observer = new MutationObserver(
                        function () {
                            cleanFoundationAccordion(accordion);
                        }
                    );

                    observer.observe(accordion, {
                        subtree: true,
                        attributes: true,
                        attributeFilter: [
                            'role',
                            'aria-selected'
                        ]
                    });
                }
            );
        }

        /**
         * Ensure the cookie plugin's link-based buttons can be operated
         * with both Enter and Space.
         */
        function prepareCookieBarForKeyboard(cookieBar) {
            const cookieButtons = cookieBar.querySelectorAll(
                'a[role="button"]:not([href]), ' +
                'a.cli-plugin-button:not([href])'
            );

            cookieButtons.forEach(function (button) {
                /*
                 * An anchor without an href is not automatically included
                 * in the keyboard tab order.
                 */
                button.setAttribute('tabindex', '0');

                // Prevent duplicate keyboard event listeners.
                if (
                    button.dataset.obrKeyboardInitialised ===
                    'true'
                ) {
                    return;
                }

                button.dataset.obrKeyboardInitialised = 'true';

                button.addEventListener(
                    'keydown',
                    function (event) {
                        if (
                            event.key === 'Enter' ||
                            event.key === ' '
                        ) {
                            event.preventDefault();
                            button.click();
                        }
                    }
                );
            });
        }

        /**
         * Find the site's skip link.
         */
        function findSkipLink() {
            return document.querySelector(
                'a.skip-link, ' +
                'a[href="#main-content"], ' +
                'a[href="#main"], ' +
                'a[href="#content"], ' +
                'a[href="#primary"]'
            );
        }

        /**
         * Place the cookie banner immediately before the skip link in the
         * DOM so the cookie controls are reached first when tabbing.
         */
        function positionCookieBarBeforeSkipLink(cookieBar) {
            const skipLink = findSkipLink();

            if (skipLink && skipLink.parentNode) {
                const isImmediatelyBeforeSkipLink =
                    cookieBar.parentNode === skipLink.parentNode &&
                    cookieBar.nextElementSibling === skipLink;

                if (!isImmediatelyBeforeSkipLink) {
                    skipLink.parentNode.insertBefore(
                        cookieBar,
                        skipLink
                    );
                }

                return;
            }

            /*
             * Fall back to the beginning of the body if a skip link
             * cannot be found.
             */
            if (document.body.firstElementChild !== cookieBar) {
                document.body.insertBefore(
                    cookieBar,
                    document.body.firstChild
                );
            }
        }

        /**
         * Set the CSS variable to the height of the visible cookie bar.
         * Reset it to zero when the cookie bar is hidden.
         */
        function updateCookieBarOffset() {
            const cookieBar = document.getElementById(
                'cookie-law-info-bar'
            );

            if (!cookieBar) {
                document.documentElement.style.setProperty(
                    '--cookie-bar-height',
                    '0px'
                );

                return;
            }

            const styles = window.getComputedStyle(cookieBar);
            const rectangle = cookieBar.getBoundingClientRect();

            const isVisible =
                cookieBar.isConnected &&
                styles.display !== 'none' &&
                styles.visibility !== 'hidden' &&
                rectangle.height > 0;

            const height = isVisible ? rectangle.height : 0;

            document.documentElement.style.setProperty(
                '--cookie-bar-height',
                height + 'px'
            );
        }

        /**
         * Initialise the current cookie banner.
         *
         * This may run more than once because the cookie plugin can move
         * or recreate its banner after the page has loaded.
         */
        function initialiseCookieBar() {
            const cookieBar = document.getElementById(
                'cookie-law-info-bar'
            );

            if (!cookieBar) {
                updateCookieBarOffset();
                return;
            }

            positionCookieBarBeforeSkipLink(cookieBar);
            prepareCookieBarForKeyboard(cookieBar);
            updateCookieBarOffset();

            /*
             * Do not attach another set of observers if this is still
             * the same cookie banner element.
             */
            if (observedCookieBar === cookieBar) {
                return;
            }

            if (cookieBarResizeObserver) {
                cookieBarResizeObserver.disconnect();
            }

            if (cookieBarMutationObserver) {
                cookieBarMutationObserver.disconnect();
            }

            observedCookieBar = cookieBar;

            /*
             * Update the header offset if the cookie bar changes height,
             * including when its content wraps on smaller screens.
             */
            if ('ResizeObserver' in window) {
                cookieBarResizeObserver = new ResizeObserver(
                    updateCookieBarOffset
                );

                cookieBarResizeObserver.observe(cookieBar);
            }

            /*
             * Watch for the plugin changing the banner's content,
             * classes, or inline styles.
             */
            cookieBarMutationObserver = new MutationObserver(
                function () {
                    prepareCookieBarForKeyboard(cookieBar);
                    updateCookieBarOffset();
                }
            );

            cookieBarMutationObserver.observe(cookieBar, {
                subtree: true,
                childList: true,
                attributes: true,
                attributeFilter: [
                    'style',
                    'class'
                ]
            });
        }

        /**
         * Watch for the cookie plugin adding, replacing, or moving
         * its banner after the page has loaded.
         */
        function watchForCookieBar() {
            initialiseCookieBar();

            const documentObserver = new MutationObserver(
                function () {
                    initialiseCookieBar();
                }
            );

            documentObserver.observe(document.body, {
                subtree: true,
                childList: true
            });

            window.addEventListener(
                'resize',
                updateCookieBarOffset
            );
        }

        /**
         * Initialise all accessibility and cookie-bar fixes.
         */
        function initialiseAccessibilityFixes() {
            fixMegaMenuAccessibility();
            fixFoundationAccordions();
            watchForCookieBar();
        }

        if (document.readyState === 'loading') {
            document.addEventListener(
                'DOMContentLoaded',
                initialiseAccessibilityFixes
            );
        } else {
            initialiseAccessibilityFixes();
        }
    })();</script> </body></html>