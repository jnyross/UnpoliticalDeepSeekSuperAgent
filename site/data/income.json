      "formula": "sum(non-tax-type records) - non-tax",
      "residual_gbp_billion": -0.0,
      "tolerance_gbp_billion": 1e-06
    },
    {
      "name": "Mixed other line split",
      "formula": "other-taxes + other-non-tax - mixed-other-receipts",
      "residual_gbp_billion": -0.0,
      "tolerance_gbp_billion": 1e-06
    },
    {
      "name": "Spending and receipts",
      "formula": "tme - receipts - borrowing",
